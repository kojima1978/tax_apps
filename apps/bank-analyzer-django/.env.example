# ==============================================================================
# Bank Analyzer Django - Environment Configuration
# ==============================================================================
# manage.bat start 時に .env が存在しなければ本ファイルから自動作成されます。
# 値は docker-compose.yml のデフォルトと一致させてあります。
# 本番環境では SECRET_KEY と DB_PASSWORD を必ず変更してください。
# ==============================================================================

# Django Settings
# 本番起動（manage.sh start --prod bank-analyzer-django）のときは、開発用の既定値の
# ままなら manage.sh が一意の値を生成して .env へ書き戻す。DB_PASSWORD を手で
# 書き換えると既存ロールのパスワードと食い違って繋がらなくなる。
DJANGO_SECRET_KEY=dev-secret-key-not-for-production
DJANGO_DEBUG=True

# 許可するホスト名（カンマ区切り）。ゲートウェイは任意のホスト名を受けて
# ブラウザが打ったホストをそのまま渡すため、LAN の IP で開く経路を残すには
# `*` が必要。社内LANの外へ出すときは具体名に絞ること。
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,bank-analyzer,*

# Cookie に Secure 属性を付けるか。ゲートウェイは HTTP(80) なので False。
# True にすると CSRF トークンとセッションがブラウザに保存されず、画面は出るのに
# 保存・取込・ログインが全部失敗する。HTTPS を張ったときだけ True。
DJANGO_SECURE_COOKIES=False

# Database Settings (docker-compose.yml defaults)
DB_PASSWORD=dev-password-change-in-production
