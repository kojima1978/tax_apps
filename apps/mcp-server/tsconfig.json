{
  // 型チェック用。テストも含めて見る（vitest は型を見ないので、ここで見ないと
  // テストの型崩れに誰も気づかない）。出力は tsconfig.build.json が担当する。
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // rootDir を1つ上（apps/）にしてあるのは、asset-valuation の src/domain を相対 import するため
    // （normalize_asset_case。写しを持たない）。dist は dist/mcp-server/src/index.js になる。
    "rootDir": "..",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  "include": ["src"]
}
